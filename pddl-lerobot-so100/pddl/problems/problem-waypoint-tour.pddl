(define (problem waypoint-tour)
  (:domain lerobot-so100)
  (:objects
    so100 - robot
    main-gripper - gripper
    home staging waypoint opposite goal - pose
  )
  (:init
    (enabled so100)
    (at so100 home)
    (gripper-closed main-gripper)
    (adjacent home staging)
    (adjacent staging home)
    (adjacent staging waypoint)
    (adjacent waypoint staging)
    (adjacent waypoint opposite)
    (adjacent opposite waypoint)
    (adjacent opposite goal)
    (adjacent goal opposite)
    (= (x home) 0.0)
    (= (y home) 0.20)
    (= (z home) 0.12)
    (= (x staging) 0.05)
    (= (y staging) 0.20)
    (= (z staging) 0.10)
    (= (x waypoint) 0.08)
    (= (y waypoint) 0.18)
    (= (z waypoint) 0.09)
    (= (x opposite) -0.08)
    (= (y opposite) 0.22)
    (= (z opposite) 0.10)
    (= (x goal) 0.12)
    (= (y goal) 0.16)
    (= (z goal) 0.08)
  )
  (:goal (at so100 goal))
)
